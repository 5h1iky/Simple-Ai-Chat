<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".CrashReporter"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.CRtools"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.CRtools">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:theme="@style/Theme.CRtools" />

        <activity
            android:name=".ChatActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.CRtools" />

        <activity
            android:name=".AboutActivity"
            android:exported="false"
            android:theme="@style/Theme.CRtools" />

        <!-- Compose 页面（1.1 角色卡） -->
        <activity
            android:name=".CharacterListActivity"
            android:exported="false"
            android:theme="@style/Theme.CRtools" />

        <activity
            android:name=".CharacterEditActivity"
            android:exported="false"
            android:theme="@style/Theme.CRtools" />

        <!-- Compose 页面（1.2 世界书） -->
        <activity
            android:name=".WorldInfoListActivity"
            android:exported="false"
            android:theme="@style/Theme.CRtools" />

        <activity
            android:name=".WorldInfoEditActivity"
            android:exported="false"
            android:theme="@style/Theme.CRtools" />

        <!-- Compose 页面（2.1 羁绊档案） -->
        <activity
            android:name=".BondActivity"
            android:exported="false"
            android:theme="@style/Theme.CRtools" />

        <!-- Compose 页面（2.2 文字冒险） -->
        <activity
            android:name=".AdventureActivity"
            android:exported="false"
            android:theme="@style/Theme.CRtools" />

    </application>

</manifest>
