<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".CrashReporter"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.CRtools"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.CRtools">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          D9：所有 Activity 原本没有 configChanges，转屏即走 onCreate 重建 ——
          编辑页未保存的文本、对话框、聊天输入框内容全部丢失，
          导出流程跨配置变更后 json == null 会「不写文件也不提示」。
          这里让这些页面自己处理常见的配置变更（Compose 会正常重组布局），
          同时避免 ChatActivity 因转屏重建而打断进行中的流式回复（A4 的现实触发路径之一）。

          注意：不声明 "locale"，系统语言变化时仍应重建以重新注入 locale。
        -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|uiMode|fontScale"
            android:theme="@style/Theme.CRtools" />

        <activity
            android:name=".ChatActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|uiMode|fontScale"
            android:theme="@style/Theme.CRtools" />

        <activity
            android:name=".AboutActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|uiMode|fontScale"
            android:theme="@style/Theme.CRtools" />

        <!-- Compose 页面（1.1 角色卡） -->
        <activity
            android:name=".CharacterListActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|uiMode|fontScale"
            android:theme="@style/Theme.CRtools" />

        <activity
            android:name=".CharacterEditActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|uiMode|fontScale"
            android:theme="@style/Theme.CRtools" />

        <!-- Compose 页面（1.2 世界书） -->
        <activity
            android:name=".WorldInfoListActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|uiMode|fontScale"
            android:theme="@style/Theme.CRtools" />

        <activity
            android:name=".WorldInfoEditActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|uiMode|fontScale"
            android:theme="@style/Theme.CRtools" />

        <!-- Compose 页面（2.1 羁绊档案） -->
        <activity
            android:name=".BondActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|uiMode|fontScale"
            android:theme="@style/Theme.CRtools" />

        <!-- Compose 页面（2.2 文字冒险） -->
        <activity
            android:name=".AdventureActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|uiMode|fontScale"
            android:theme="@style/Theme.CRtools" />

    </application>

</manifest>
